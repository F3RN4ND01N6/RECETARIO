<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recetario.Views.LoginPage"
             BackgroundColor="#FFFDF9"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <!-- Imagen de Fondo Ilustrada de Ingredientes y Especias -->
        <Image Source="fondo_feed.jpg"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   Opacity="0.88" />
        <ScrollView>
            <Grid RowDefinitions="Auto,*" Padding="24" MaximumWidthRequest="600" MaximumHeightRequest="800" HorizontalOptions="Center">

                <!-- Encabezado / Logo -->
                <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,30,0,25" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="#FFE8D6"
                            Stroke="#472C4C"
                            StrokeThickness="2"
                            WidthRequest="100"
                            HeightRequest="100"
                            HorizontalOptions="Center">
                        <Image Source="logo.jpg"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>
                    </Border>
                    <Label Text="Raccolta di ricette"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="DarkMagenta"
                           HorizontalTextAlignment="Center" 
                           FontFamily="ScriptFont"/>
                    <Label Text="Tu recetario de estación y cocina de autor"
                           FontSize="13"
                           TextColor="#756A63"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Tarjeta Principal de Login -->
                <Border Grid.Row="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="#FFFFFF"
                        Stroke="#F3E9DF"
                        StrokeThickness="1"
                        Padding="24"
                        Shadow="{Shadow Brush='#15000000', Offset='0,6', Radius=14}">

                    <VerticalStackLayout Spacing="16">

                        <Label Text="Iniciar Sesión"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#D05000" />

                        <!-- Campo Usuario / Correo -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Usuario o Correo Electrónico" FontSize="12" FontAttributes="Bold" TextColor="#D05000" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#E2D6CB" StrokeThickness="1" Padding="12,0" BackgroundColor="#FAF6F2">
                                <Entry x:Name="TxtIdentificador"
                                       Placeholder="ej. fernando@raccolta.cl o admin@raccolta.cl"
                                       TextColor="#2C231E"
                                       PlaceholderColor="#A89B91"
                                       FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo Contraseña -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="#D05000" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#E2D6CB" StrokeThickness="1" Padding="12,0" BackgroundColor="#FAF6F2">
                                <Entry x:Name="TxtPassword"
                                       Placeholder="••••••••"
                                       IsPassword="True"
                                       TextColor="#2C231E"
                                       PlaceholderColor="#A89B91"
                                       FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Switch / Botón Modo Administrador -->
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="#FFF6EE"
                                Stroke="#FFD6BA"
                                StrokeThickness="1"
                                Padding="14,10">
                            <Grid ColumnDefinitions="*,55" ColumnSpacing="12" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="¿Eres Administrador?" FontAttributes="Bold" FontSize="13" TextColor="#D05000" />
                                    <Label Text="Accede al panel de moderación con administradores.json" FontSize="11" TextColor="#8D5537" />
                                </VerticalStackLayout>
                                <Switch x:Name="SwitchAdmin"
                                        Grid.Column="1"
                                        WidthRequest="50"
                                        MaximumWidthRequest="50"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End"
                                        OnColor="#FF9E5E"
                                        ThumbColor="#FFF0FF" />
                            </Grid>
                        </Border>

                        <!-- Botón Ingresar -->
                        <Button Text="Ingresar a la App"
                                Clicked="OnIngresarClicked"
                                BackgroundColor="#FF9E5E"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="48"
                                Margin="0,8,0,0" />

                        <!-- Divisor -->
                        <BoxView HeightRequest="1" Color="#EFE6DD" Margin="0,8" />

                        <!-- Enlace a Registro -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="¿Aún no tienes una cuenta?" FontSize="12" TextColor="#756A63" HorizontalTextAlignment="Center" />
                            <Button Text="Crear cuenta nueva"
                                    Clicked="OnRegistrarseClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#D05000"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    BorderColor="#FFD6BA"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="38" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
