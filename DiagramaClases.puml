@startuml DiagramaClases
title Diagrama de Clases Completo - Raccolta di ricette (Recetario)

package "Recetario.Models" {

    ' === ENUMERADORES (6 en total) ===
    enum NivelDificultad {
        FACIL
        MEDIA 
        DIFICIL
    }

    enum Estacion {
        TODOELANHIO
        PRIMAVERA
        VERANO
        OTONIO 
        INVIERNO 
    }
    
    enum Origen {
        CHILE 
        ARGENTINA 
        PERU 
        COLOMBIA 
        OTRO
    }

    enum TipoPerfilUsuario {
        USUARIO_NORMAL
        CHEF_VERIFICADO
        ADMINISTRADOR
    }

    enum UnidadMedida {
        GRAMO 
        KILOGRAMO 
        MILILITRO
        LITRO 
        TAZAS 
        CUCHARADAS 
        UNIDADES
        ALGUSTO
    }

    enum TipoVegetal {
        FRUTA
        VERDURA
        OTRO
        NO_APLICA
    }

    ' === INTERFACES DOMINIO (4 en total) ===
    interface IIdentificable <<interface>> {
        + ObtenerIdentificador() : string 
        + ObtenerResumenEntidad() : string 
    }

    interface IValidable <<interface>> {
        + EsValido() : bool 
        + ObtenerErroresValidacion() : List<string> 
    }

    interface ICalificable <<interface>> {
        + AgregarCalificacion(Calificacion calificacion) : void
        + ObtenerPromedioCalificaciones() : double
    }

    interface IFiltrable <<interface>> {
        + CumpleFiltro(FiltroReceta filtro) : bool
    }

    ' === SEGURIDAD Y ACTIVACIÓN ADMIN ===
    class CodigoConfirmacionAdmin {
        + string Codigo
        + bool Utilizado
        + string UsadoPorCorreo
        + DateTime? FechaUso
        + CodigoConfirmacionAdmin()
        + CodigoConfirmacionAdmin(string codigo)
        + string ObtenerIdentificador()
        + string ObtenerResumenEntidad()
    }

    ' === CLASES BASE Y USUARIOS (Herencias 1, 2, 3) ===
    abstract class Usuario {
        # string idUsuario 
        # string nombreUsuario  
        # string correo
        # string password
        # string biografia 
        # DateTime fechaRegistro 
        # TipoPerfilUsuario tipoPerfil
        # ConfiguracionPerfil configuracionPerfil 

        + Usuario()
        + string IdUsuario()
        + string NombreUsuario() 
        + string Correo()
        + string Password()
        + void EstablecerPassword(string nuevaPassword)
        + bool ValidarPassword(string passwordAValidar)
        + string Biografia() 
        + DateTime FechaRegistro() 
        + ConfiguracionPerfil ConfiguracionPerfil() 
        + TipoPerfilUsuario ObtenerTipoPerfil()
        + void ActualizarDatosBasicos(string nuevoNombre, string nuevoCorreo, string nuevaBiografia)
        + abstract void EjecutarAccionRol()
        + string ObtenerIdentificador()
        + string ObtenerResumenEntidad()
        + bool EsValido() 
        + List<string> ObtenerErroresValidacion()
    }

    class UsuarioNormal {
        - List<string> idsRecetasFavoritas
        + UsuarioNormal()
        + void EjecutarAccionRol()
        + void MarcarFavorita(string idReceta)
        + void DesmarcarFavorita(string idReceta)
        + bool EsFavorita(string idReceta)
        + IReadOnlyList<string> ObtenerIdsFavoritas()
    }

    class CreadorEspecialista {
        - string credencialesChef
        + CreadorEspecialista()
        + void EjecutarAccionRol()
        + string CredencialesChef()
        + void ActualizarCredenciales(string nuevasCredenciales)
        + RecetaPublica PublicarRecetaOficial(RecetaPrivada privada)
    }

    class Administrador {
        - string nivelAcceso
        + Administrador()
        + void EjecutarAccionRol()
        + string NivelAcceso()
        + void ForzarEliminacionReceta(string idReceta)
    }

    class ConfiguracionPerfil {
        - Estacion estacionPreferida
        - Origen origen 
        - string regionPreferida
        - bool ingredientesEstacion 

        + ConfiguracionPerfil()
        + Estacion EstacionPreferida()
        + Origen Origen()
        + string RegionPreferida()
        + bool IngredientesEstacion()
        + void ActualizarConfiguracion(Estacion estacion, Origen paisOrigen, string region, bool priorizarEstacion)
    }

    ' === CLASES DE RECETA (Herencia 4) ===
    abstract class Receta {
        # string idReceta
        # string idUsuarioAutor 
        # string titulo 
        # string categoria
        # string tipoDieta
        # List<string> etiquetas
        # string imagenPlatillo 
        # int tiempoPreparacion 
        # int porciones 
        # NivelDificultad dificultad 
        # Estacion estacion 
        # DateTime fechaPublicacion 
        # Origen origen 
        # string region
        # List<IngredienteReceta> ingredientes
        # List<PasoPreparacion> pasos

        + Receta()
        + string ObtenerIdentificador() 
        + bool EsValido()
        + List<string> ObtenerErroresValidacion()
        + {abstract} bool EsPublicaEnFeed()
        + {abstract} string ObtenerResumenEntidad()
        + {static} string NormalizarRutaImagen(string valor, string tituloReceta)
    }

    class RecetaPrivada {
        - string notasPersonales 
        - bool soloDispositivoLocal 

        + RecetaPrivada()
        + string NotasPersonales() 
        + bool SoloDispositivoLocal() 
        + void ActualizarNotasPrivadas(string notas, bool soloLocal)
        + bool EsPublicaEnFeed()
        + string ObtenerResumenEntidad() 
    }

    class RecetaPublica {
        - string especialidadChef 
        - bool verificadaPorChef 
        - bool destacadaEnFeed 
        - List<Calificacion> calificaciones

        + RecetaPublica()
        + string EspecialidadChef() 
        + bool VerificadaPorChef() 
        + bool DestacadaEnFeed() 
        + bool EsPublicaEnFeed()
        + string ObtenerVerificacion()
        + string ObtenerResumenEntidad()
        + void AgregarCalificacion(Calificacion calificacion)
        + double ObtenerPromedioCalificaciones()
        + bool CumpleFiltro(FiltroReceta filtro)
        + IReadOnlyList<Calificacion> ObtenerCalificaciones()
    }

    class PasoPreparacion {
        - int numeroPaso
        - string instruccion
        - int tiempoEstimado 
        - bool completado

        + PasoPreparacion()
        + int NumeroPaso()
        + string Instruccion()
        + int TiempoEstimado() 
        + bool Completado()
        + void MarcarCompletado()
        + string FormatearPaso()
    }

    class IngredienteReceta {
        - string nombre 
        - double cantidad 
        - UnidadMedida unidad 
        - Estacion estacion 
        - bool esFrutaOVerduraEstacion 
        - TipoVegetal tipoVegetal
        - IngredienteTemporada referenciaTemporada

        + IngredienteReceta() 
        + string Nombre() 
        + double Cantidad() 
        + UnidadMedida Unidad() 
        + Estacion Estacion()
        + bool EsFrutaOVerduraEstacion() 
        + TipoVegetal TipoVegetal()
        + IngredienteTemporada ReferenciaTemporada()
        + string FormatearIngrediente() 
        + bool EsValido() 
        + List<string> ObtenerErroresValidacion()
    }

    class IngredienteTemporada {
        - string nombreFrutaVerdura
        - TipoVegetal tipo
        - Estacion estacionPrincipal 
        - Origen paisOrigen
        - string zonaCultivo 

        + IngredienteTemporada()
        + string NombreFrutaVerdura()
        + TipoVegetal Tipo()
        + Estacion EstacionPrincipal() 
        + Origen PaisOrigen()
        + string ZonaCultivo() 
    }

    class Calificacion {
        - string idCalificacion
        - string idUsuario
        - int puntaje
        - string comentario
        - DateTime fecha

        + Calificacion()
        + Calificacion(string idUsuario, int puntaje, string comentario)
        + string IdCalificacion()
        + string IdUsuario()
        + int Puntaje()
        + string Comentario()
        + DateTime Fecha()
    }

    class FiltroReceta {
        - TipoVegetal? tipoFrutaOVerdura
        - string nombreIngrediente
        - Estacion? estacionTemporada
        - Origen? pais
        - string categoriaFiltro
        - string dietaFiltro
        - NivelDificultad? dificultad
        - bool soloVerificadasPorChef

        + FiltroReceta()
        + TipoVegetal? TipoFrutaOVerdura()
        + string NombreIngrediente()
        + Estacion? EstacionTemporada()
        + Origen? Pais()
        + string CategoriaFiltro()
        + string DietaFiltro()
        + NivelDificultad? Dificultad()
        + bool SoloVerificadasPorChef()
        + bool CumpleCriterios(Receta receta)
    }
}

package "Recetario.Services" {

    interface IPersistenciaJson<T> <<interface>> {
        + void GuardarEnArchivos(List<T> datos)
        + List<T> CargarDesdeArchivo()
        + bool ExisteArchivoJson()
        + string ObtenerRutaArchivo()
    }

    class PersistenciaJsonService<T> {
        - string rutaArchivo
        + PersistenciaJsonService(string nombreArchivo)
        + void GuardarEnArchivos(List<T> datos)
        + List<T> CargarDesdeArchivo()
        + bool ExisteArchivoJson()
        + string ObtenerRutaArchivo()
    }

    class AuthService {
        - IPersistenciaJson<UsuarioNormal> _repoUsuariosNormales
        - IPersistenciaJson<Administrador> _repoAdministradores
        - IPersistenciaJson<CodigoConfirmacionAdmin> _repoCodigosAdmin
        + AuthService()
        + (bool, string, Usuario) IniciarSesion(string identificador, string password, bool esModoAdmin)
        + (bool, string, UsuarioNormal) RegistrarUsuarioNormal(string nombre, string correo, string password, Estacion estacion, Origen origen, string region)
        + (bool, string, Administrador) RegistrarAdministrador(string nombre, string correo, string password, string codigoConfirmacion)
        + List<CodigoConfirmacionAdmin> ObtenerCodigosDisponibles()
    }

    class RecetaService {
        - IPersistenciaJson<RecetaPrivada> repoPrivado
        - IPersistenciaJson<RecetaPublica> repoPublicoFeed
        - List<RecetaPrivada> cachePrivadas
        - List<RecetaPublica> cachePublicas
        - List<IngredienteTemporada> catalogoTemporada
        - Usuario usuarioActivo

        + RecetaService()
        + void EstablecerUsuarioSesion(Usuario usuarioAutenticado)
        + void CambiarRolActivo(TipoPerfilUsuario nuevoTipo)
        + void GuardarRecetaPrivada(RecetaPrivada receta)
        + void EditarRecetaPrivada(RecetaPrivada receta)
        + void EliminarRecetaPrivada(string idReceta)
        + void PublicarRecetaEnFeed(RecetaPublica receta, Usuario autor)
        + void CalificarRecetaPublica(string idReceta, Calificacion calificacion)
        + void EliminarRecetaPublicaComoAdmin(string idReceta)
        + bool AlternarFavorita(string idReceta)
        + bool EsRecetaFavorita(string idReceta)
        + List<RecetaPublica> FiltrarFeedGlobal(FiltroReceta filtro)
        + List<RecetaPublica> FiltrarFeedGlobal(Estacion estacion, Origen pais)
        + List<RecetaPrivada> FiltrarRecetasPrivadas(string idUsuario, FiltroReceta filtro)
        + List<IngredienteTemporada> ConsultarCalendarioTemporada(Estacion estacion)
    }
}

' === RELACIONES Y CARDINALIDADES ===

' Implementación de Interfaces
IIdentificable <|.. Usuario
IValidable <|.. Usuario
IIdentificable <|.. Receta
IValidable <|.. Receta
IValidable <|.. IngredienteReceta
ICalificable <|.. RecetaPublica
IFiltrable <|.. RecetaPublica
IIdentificable <|.. CodigoConfirmacionAdmin
IPersistenciaJson <|.. PersistenciaJsonService

' Herencias de Usuario
Usuario <|-- UsuarioNormal
Usuario <|-- CreadorEspecialista
Usuario <|-- Administrador

' Herencia de Recetas
Receta <|-- RecetaPrivada
Receta <|-- RecetaPublica

' Composiciones (*-- Ciclo de vida dependiente)
Receta *-- "1..*" IngredienteReceta : contiene >
Receta *-- "1..*" PasoPreparacion : sigue >

' Agregaciones (o-- Independientes)
Usuario o-- "1" ConfiguracionPerfil : configura >
RecetaPublica o-- "0..*" Calificacion : recibe reseñas >

' Asociaciones y Dependencias de Servicios
Usuario "1" --> "0..*" Receta : crea >
IngredienteReceta "0..*" --> "0..1" IngredienteTemporada : referencia >
RecetaService --> "1" Usuario : usuarioActivo >
RecetaService o-- "0..*" IngredienteTemporada : catálogo >
RecetaService --> IPersistenciaJson : usa persistencia >
RecetaService ..> FiltroReceta : aplica filtros >
AuthService --> IPersistenciaJson : usa persistencia >
AuthService ..> CodigoConfirmacionAdmin : valida códigos >
AuthService ..> Usuario : gestiona sesiones >

@enduml
